SENARIBOT_PHONE_NUMBER=
SENARIBOT_OWNER_JIDS=
SENARIBOT_DB_PATH=./data/senaribot.db
SENARIBOT_LOG_LEVEL=info
SENARIBOT_PREFIX=.
SENARIBOT_RATE_LIMIT_BURST=5
SENARIBOT_WORKER_THREADS=2

# AI Assistant (APInex, OpenAI-compatible)
APAI_PROVIDER=apinex
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/gpt-6-luna
AI_MAX_HISTORY=10
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=60000
# Optional: override the default system prompt
# AI_SYSTEM_PROMPT=

# AI Summarizer (uses the same APInex settings above)
SUM_MAX_INPUT_CHARS=60000
SUM_CHUNK_CHARS=8000
SUM_MAX_OUTPUT_TOKENS=1024
SUM_MAX_FILE_BYTES=5242880
SUM_CACHE_TTL_MS=600000
SUM_MAX_CONCURRENT=2

# Habit Tracker: IANA timezone for periods, streaks and reminders
SENARIBOT_TIMEZONE=Asia/Jakarta

# Web Search (requires API key from SerpAPI or Brave Search)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
SEARCH_TIMEOUT_MS=30000

# Weather (requires API key from WeatherAPI.com - free tier: 1M calls/month)
WEATHER_API_KEY=
WEATHER_TIMEOUT_MS=15000

# GitHub (optional token for higher rate limits - 60 req/hr without, 5000 req/hr with)
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=10000

# YouTube Summarizer (uses public captions/transcripts, requires APInex AI)
YOUTUBE_TIMEOUT_MS=30000

# Currency Converter (uses free ExchangeRate-API.com - 1500 requests/month, no key needed)
CURRENCY_TIMEOUT_MS=10000
